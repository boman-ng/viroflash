Bootstrap: docker
From: ubuntu:22.04

%arguments
    VERSION=dev
    REVISION=unknown

%files
    target/release/viroflash /usr/local/bin/viroflash

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install --no-install-recommends --yes libgcc-s1 zlib1g
    rm -rf /var/lib/apt/lists/*
    chmod 0755 /usr/local/bin/viroflash
    mkdir -p /work

%environment
    export LC_ALL=C.UTF-8

%runscript
    exec /usr/local/bin/viroflash "$@"

%test
    /usr/local/bin/viroflash version

%labels
    org.opencontainers.image.title viroflash
    org.opencontainers.image.description "Viral candidate detection command-line tool"
    org.opencontainers.image.source https://github.com/boman-ng/viroflash
    org.opencontainers.image.version {{ VERSION }}
    org.opencontainers.image.revision {{ REVISION }}

%help
    Viroflash produces viral candidate reports from FASTQ or FASTQ.gz data.
    Run `apptainer run viroflash.sif --help` for command-line usage.
