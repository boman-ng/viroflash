Bootstrap: docker
From: ubuntu:22.04

%arguments
    VERSION=dev
    REVISION=unknown

%files
    target/x86_64-unknown-linux-musl/release/viroflash /usr/local/bin/viroflash

%post
    chmod 0755 /usr/local/bin/viroflash
    mkdir -p /work

%environment
    export LC_ALL=C.UTF-8

%runscript
    exec /usr/local/bin/viroflash "$@"

%test
    /usr/local/bin/viroflash --help

%labels
    org.opencontainers.image.title viroflash
    org.opencontainers.image.description Reference-group fragment evidence command-line tool
    org.opencontainers.image.source https://github.com/boman-ng/viroflash
    org.opencontainers.image.version {{ VERSION }}
    org.opencontainers.image.revision {{ REVISION }}

%help
    Viroflash measures profile-attributed fragment fractions from FASTQ or FASTQ.gz data.
    Run `apptainer run viroflash.sif --help` for command-line usage.
